# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored — never commit real keys.
# On Render, enter these in the service's "Environment" tab instead.

# Printify → My account → Connections → Generate token
PRINTIFY_API_KEY=
# Optional: leave blank to use the first shop on your Printify account
PRINTIFY_SHOP_ID=

# Podbase → your dashboard's API / developer settings
PODBASE_API_KEY=

# Stripe → Developers → API keys (start with the sk_test_ key)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Where customers go after checkout
SITE_URL=https://k1llajay.com
STORE_PATH=/laurent-by-jae-laurent

# Comma-separated sites allowed to call this backend
ALLOWED_ORIGINS=https://k1llajay.com,https://www.k1llajay.com,http://localhost:5500,http://127.0.0.1:5500

# Flat shipping charged at checkout, in cents (799 = $7.99), and countries you ship to
SHIPPING_RATE_CENTS=799
SHIPPING_COUNTRIES=US

# false = paid orders wait in Printify for you to approve; true = sent to production automatically
AUTO_SEND_TO_PRODUCTION=false

PORT=3000
